{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/assets/([^/]+-[A-Za-z0-9_-]{8,}\\.[a-zA-Z0-9]+)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/work", "destination": "/work/index.html" },
    { "source": "/work/", "destination": "/work/index.html" },
    { "source": "/services", "destination": "/services/index.html" },
    { "source": "/services/", "destination": "/services/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/about/", "destination": "/about/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/contact/", "destination": "/contact/index.html" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
